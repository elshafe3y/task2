namespace task2
{
    public class calculator
    {
        public int add(int a, int b)
        {
            return a + b;
        }
        public int sub(int a, int b)
        {
            return a - b;
        }
        public int mul(int a, int b)
        {
            return a * b;
        }
        public double div(int a, int b)
        {
            return (double)a / b;
        }
    }
    internal class Program
    {
        static void Main(string[] args)
        {
            calculator calc = new calculator();
            Console.Write("Enter first number: ");
            int num1 = int.Parse(Console.ReadLine());
            Console.Write("Enter second number: ");
            int num2 = int.Parse(Console.ReadLine());
            Console.WriteLine("\n1-addition\n2-subtraction \n3-multiplication \n4-division");
            Console.Write("\nEnter your choice: ");
            int num = int.Parse(Console.ReadLine());

            switch (num)
            {
                case 1:
                    Console.WriteLine("\nAddition: " + calc.add(num1, num2));
                    break;
                case 2:
                    Console.WriteLine("\nSubtraction: " + calc.sub(num1, num2));
                    break;
                case 3:
                    Console.WriteLine("\nMultiplication: " + calc.mul(num1, num2));
                    break;
                case 4:
                    Console.WriteLine("\nDivision: " + calc.div(num1, num2));
                    break;
                default:
                    Console.WriteLine("\nInvalid choice");
                    break;
            }
        }
    }
}
