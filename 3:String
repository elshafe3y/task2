//Exercise 4
string[] names = new string[5];
for (int i = 0; i < names.Length; i++)
{
    Console.Write($"Enter name {i + 1}: ");
    names[i] = Console.ReadLine();
}
Console.WriteLine("\nNames in Uppercase:");
for (int i = 0; i < names.Length; i++)
{
    Console.WriteLine(names[i].ToUpper());
}
