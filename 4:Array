int[] number = new int[5];
float sum = 0;
for (int i = 0; i < number.Length; i++)
{
    Console.Write($"Enter Number {i + 1}: ");
    number[i] = int.Parse(Console.ReadLine());
}
int max = number[0];
int min = number[0];
Console.WriteLine("\nNumber (odd or even):");
for (int i = 0; i < number.Length; i++)
{
    sum += number[i];
    if (number[i] % 2 == 0)
    {
        Console.WriteLine(number[i] + " is even");
    }
    else
    {
        Console.WriteLine(number[i] + " is odd");
    }

    if (number[i] > max)
    {
        max = number[i];
    }

    if (number[i] < min)
    {
        min = number[i];
    }

}
Console.WriteLine("\nSum of all numbers: " + sum);
Console.WriteLine("Average of all numbers: " + sum / number.Length);
Console.WriteLine("Maximum number: " + max);
Console.WriteLine("Minimum number: " + min);
